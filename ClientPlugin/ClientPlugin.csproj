<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ClientPlugin</RootNamespace>
    <AssemblyName>WaterShading</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Target platforms on Windows and Linux -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net48;net10.0</TargetFrameworks>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>

    <!-- Ensure SDK generates assembly attributes (no need for AssemblyInfo) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- The game assemblies are .NET Framework builds; the compile only needs their metadata -->
    <NoWarn>$(NoWarn);CS0618;CS1701;CS1702;CS0436;CS8032;MSB3277;MSB3243</NoWarn>

    <!-- Default configuration if none supplied -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <!-- Keep original behavior for post/pre build events -->
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin/Debug/</OutputPath>
    <DefineConstants>DEBUG;TRACE;PULSAR;LOCAL_BUILD</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin/Release/</OutputPath>
    <DefineConstants>TRACE;PULSAR;LOCAL_BUILD</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Only the game assemblies the plugin uses; the .NET facade assemblies come from the target framework. -->
  <ItemGroup>
    <Reference Include="netstandard">
      <HintPath>$(Bin64Dir)netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sandbox.Common">
      <HintPath>$(Bin64Dir)Sandbox.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Sandbox.Game">
      <HintPath>$(Bin64Dir)Sandbox.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SpaceEngineers.Game">
      <HintPath>$(Bin64Dir)SpaceEngineers.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage">
      <HintPath>$(Bin64Dir)VRage.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(Bin64Dir)VRage.Game.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Library">
      <HintPath>$(Bin64Dir)VRage.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VRage.Math">
      <HintPath>$(Bin64Dir)VRage.Math.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <Target Name="ValidateProps" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Bin64)' == ''"
           Text="Could not locate the Space Engineers Bin64 folder. Set &lt;Bin64&gt; in &quot;$(RepoRoot)Directory.Build.props.user&quot;." />
    <Error Condition="!Exists('$(Bin64)')"
           Text="Invalid Bin64 path &quot;$(Bin64)&quot; in &quot;$(RepoRoot)Directory.Build.props[.user]&quot;." />
    <Message Condition="'$(Pulsar)' == ''"
             Text="Pulsar is not set, the client plugin will not be deployed." />
    <Warning Condition="'$(Pulsar)' != '' And !Exists('$(Pulsar)')"
             Text="Pulsar folder &quot;$(Pulsar)&quot; does not exist, the client plugin will not be deployed." />
  </Target>

  <!-- Copies the build output into Pulsar's Local plugin folder, but only if the Pulsar
       property is set (see Directory.Build.props):
         net4x (.NET Framework) -> Pulsar/Legacy/Local/$(AssemblyName)
         net5+ (.NET)           -> Pulsar/Interim/Local/$(AssemblyName)
       Each build lands in its own subfolder as plugin.dll next to the plugin.xml
       metadata, so Pulsar picks up the friendly name and the runtime restrictions.
       (Pulsar/Modern belongs to Space Engineers 2 and is never a target here.) -->
  <Target Name="DeployPlugin" AfterTargets="Build"
          Condition="'$(RunPostBuildEvent)' != 'Never' And '$(TargetFramework)' != '' And Exists('$(Pulsar)')">
    <PropertyGroup>
      <PulsarEdition Condition="$(TargetFramework.StartsWith('net4'))">Legacy</PulsarEdition>
      <PulsarEdition Condition="'$(PulsarEdition)' == '' And Exists('$(Pulsar)$(PathSeparator)Interim')">Interim</PulsarEdition>
      <!-- Without its own data folder the Interim launcher falls back to the Legacy one.
           Deploy there only if no .NET Framework build is claiming the same folder. -->
      <PulsarEdition Condition="'$(PulsarEdition)' == '' And '$(TargetFrameworks)' == ''">Legacy</PulsarEdition>

      <PulsarEditionDir Condition="'$(PulsarEdition)' != ''">$(Pulsar)$(PathSeparator)$(PulsarEdition)</PulsarEditionDir>
      <PulsarEdition Condition="'$(PulsarEditionDir)' != '' And !Exists('$(PulsarEditionDir)')"></PulsarEdition>

      <PluginDirectory Condition="'$(PulsarEdition)' != ''">$(PulsarEditionDir)$(PathSeparator)Local$(PathSeparator)$(AssemblyName)</PluginDirectory>
      <PluginDataFile>$(RepoRoot)$(AssemblyName).xml</PluginDataFile>
    </PropertyGroup>

    <Warning Condition="'$(PluginDirectory)' == ''"
             Text="No Pulsar plugin folder for the $(TargetFramework) build under &quot;$(Pulsar)&quot;, skipping its deployment." />

    <MakeDir Condition="'$(PluginDirectory)' != ''" Directories="$(PluginDirectory)" />
    <Copy Condition="'$(PluginDirectory)' != ''"
          SourceFiles="$(TargetPath)" DestinationFiles="$(PluginDirectory)$(PathSeparator)plugin.dll" />
    <Copy Condition="'$(PluginDirectory)' != '' And Exists('$(TargetDir)$(TargetName).pdb')"
          SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFiles="$(PluginDirectory)$(PathSeparator)plugin.pdb" />
    <Copy Condition="'$(PluginDirectory)' != '' And Exists('$(PluginDataFile)')"
          SourceFiles="$(PluginDataFile)" DestinationFiles="$(PluginDirectory)$(PathSeparator)plugin.xml" />
    <Message Condition="'$(PluginDirectory)' != ''" Importance="high"
             Text="Deployed the $(TargetFramework) client build to &quot;$(PluginDirectory)&quot;" />
  </Target>


  <Import Project="..\Shared\Shared.projitems" Label="Shared" />
</Project>
